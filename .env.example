# ===== CareerkitAgent 环境配置 =====
# 复制为 .env 后按需修改

# --- 数据库 (PostgreSQL + pgvector) ---
POSTGRES_PASSWORD=careerkit
POSTGRES_USER=careerkit
POSTGRES_DB=careerkit

DATABASE_URL=postgresql+psycopg://careerkit:careerkit@localhost:5432/careerkit

# --- 缓存 (Redis) ---
REDIS_URL=redis://localhost:6379/0
# 容器内 Redis 密码（compose 部署必填，生产环境务必改为随机强密码）
REDIS_PASSWORD=change-me-to-a-random-password

# --- 对象存储 (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=careerkit
MINIO_SECRET_KEY=careerkit123
MINIO_BUCKET=careerkit
MINIO_SECURE=false

# --- 安全 ---
# 用于加密 LLM API Key 的密钥(32字节hex)。生产环境务必更换为长随机值
CAREERKIT_SECRET=change-me-to-a-long-random-string-32bytes
# CORS 允许来源
CORS_ORIGINS=http://localhost:3000

# --- LLM 默认值(可在设置页覆盖) ---
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Agent 运行时 ---
# 质量门禁阈值(0-10)，业务 Agent 输出评审低于该分将触发重试或降级
QUALITY_GATE_THRESHOLD=6.0
# 记忆滑动窗口轮数
MEMORY_WINDOW_ROUNDS=10
# 记忆摘要 Token 触发阈值
MEMORY_SUMMARY_TOKEN_THRESHOLD=4000
